                            let penaltyText = m.penaltyFee > 0 ? ` (ค่าห้อง 85 + ปรับเลท ${m.penaltyFee}฿)` : '';
                            let customText = m.customAdjustment !== 0 ? ` [ปรับเงิน ${m.customAdjustment > 0 ? '+' : ''}${m.customAdjustment}฿]` : '';
                            text += `${m.name} - รวม ฿${m.totalOwedAmount}${penaltyText}${customText}\n`;
                        });
                        text += `\n*โปรดสแกน QR จ่ายตามยอด และแนบสลิปผ่านเว็บได้เลยน้า 💕`;
                    } else {
