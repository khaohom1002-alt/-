                // --- DATE & WEEK HELPER FUNCTIONS ---

                function getMonday(d) {
                    const date = new Date(d);
                    const day = date.getDay();
                    const diff = date.getDate() - day + (day === 0 ? -6 : 1);
                    const monday = new Date(date.setDate(diff));
                    monday.setHours(0, 0, 0, 0);
                    return monday;
                }

                function getWeekKey(dateObj) {
                    const mon = getMonday(dateObj);
                    const year = mon.getFullYear();
                    const firstJan = new Date(year, 0, 1);
                    const numberOfDays = Math.floor((mon - firstJan) / (24 * 60 * 60 * 1000));
                    const weekNum = Math.ceil((numberOfDays + firstJan.getDay() + 1) / 7);
                    return `${year}-W${weekNum < 10 ? '0' + weekNum : weekNum}`;
                }

                function getWeekLabelFromKey(weekKey) {
                    const parts = weekKey.split('-W');
                    if (parts.length < 2) return weekKey;
                    return `สัปดาห์ที่ ${parts[1]} (${parts[0]})`;
                }

                const targetDate = computed(() => {
                    const d = new Date(now.value);
                    d.setDate(d.getDate() + (selectedWeekOffset.value * 7));
                    return d;
                });

                const currentWeekKey = computed(() => getWeekKey(now.value));
                const selectedWeekKey = computed(() => getWeekKey(targetDate.value));

                const selectedMemberDetail = computed(() => {
                    if (!selectedMemberId.value) return null;
                    return memberPaymentList.value.find(m => m.id === selectedMemberId.value) || null;
                });

                const currentDateFormatted = computed(() => {
                    return now.value.toLocaleDateString('th-TH', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                });

                const selectedWeekLabel = computed(() => {
                    const mon = getMonday(targetDate.value);
                    const sun = new Date(mon);
                    sun.setDate(sun.getDate() + 6);

                    const opt = { day: 'numeric', month: 'short' };
                    const monStr = mon.toLocaleDateString('th-TH', opt);
                    const sunStr = sun.toLocaleDateString('th-TH', opt);

                    if (selectedWeekOffset.value === 0) {
                        return `สัปดาห์นี้ (${monStr} - ${sunStr})`;
                    } else if (selectedWeekOffset.value === -1) {
                        return `สัปดาห์ที่แล้ว (${monStr} - ${sunStr})`;
                    } else if (selectedWeekOffset.value === 1) {
                        return `สัปดาห์หน้า (${monStr} - ${sunStr})`;
                    } else {
                        return `${monStr} - ${sunStr}`;
                    }
                });

                const currentStatusInfo = computed(() => {
                    const day = now.value.getDay();
                    if (selectedWeekOffset.value < 0) {
                        return { text: 'สัปดาห์ในอดีต', color: 'text-gray-500', icon: 'fa-solid fa-clock-rotate-left' };
                    }
                    if (selectedWeekOffset.value > 0) {
                        return { text: 'สัปดาห์ในอนาคต', color: 'text-purple-500', icon: 'fa-solid fa-calendar-plus' };
                    }

                    if (day >= 1 && day <= 5) {
                        return { text: 'จ่ายช่วงปกติ (85 บาท)', color: 'text-emerald-600', icon: 'fa-solid fa-circle-check' };
                    } else if (day === 6) {
                        return { text: 'เกินกำหนดวันแรก! ค่าปรับ +5 บาท (รวม 90 บาท)', color: 'text-amber-600', icon: 'fa-solid fa-triangle-exclamation' };
                    } else {
                        return { text: 'เกินกำหนดวันที่สอง! ค่าปรับ +10 บาท (รวม 95 บาท)', color: 'text-rose-600', icon: 'fa-solid fa-triangle-exclamation' };
                    }
                });

                function calculateWeekFee(weekKey, isPaid) {
                    let fee = baseFee;
                    if (weekKey === currentWeekKey.value) {
                        const day = now.value.getDay();
                        if (day === 6) fee += penaltyStep;
                        else if (day === 0) fee += (penaltyStep * 2);
                    } else {
                        fee = baseFee + (penaltyStep * 2);
                    }
                    return fee;
                }

                const memberPaymentList = computed(() => {
                    const weekKey = selectedWeekKey.value;

                    return members.value.map(m => {
                        const memberRecords = paymentRecords.value[m.id] || {};
                        const weekRecord = memberRecords[weekKey] || { paid: false, customAdjustment: 0 };

                        const isPaid = weekRecord.paid || false;
                        const customAdjustment = weekRecord.customAdjustment || 0;
                        const currentWeekFee = calculateWeekFee(weekKey, isPaid) + customAdjustment;
                        const penaltyFee = calculateWeekFee(weekKey, isPaid) - baseFee;

                        let totalOwedAmount = 0;
                        let totalUnpaidWeeks = 0;

                        if (!isPaid) {
                            totalOwedAmount += currentWeekFee;
                            totalUnpaidWeeks += 1;
                        }

                        return {
                            id: m.id,
                            name: m.name,
                            isPaid,
                            paidAt: weekRecord.paidAt || null,
                            slipUrl: weekRecord.slipUrl || null,
                            customAdjustment,
                            currentWeekFee,
                            penaltyFee,
                            totalOwedAmount,
                            totalUnpaidWeeks
                        };
                    });
                });

                const paidCount = computed(() => memberPaymentList.value.filter(m => m.isPaid).length);
                const unpaidCount = computed(() => memberPaymentList.value.filter(m => !m.isPaid).length);

                const expectedTotalAmount = computed(() => {
                    return memberPaymentList.value.reduce((sum, m) => sum + m.currentWeekFee, 0);
                });

                const totalCollectedAmount = computed(() => {
                    return memberPaymentList.value
                        .filter(m => m.isPaid)
                        .reduce((sum, m) => sum + m.currentWeekFee, 0);
                });

                const remainingAmount = computed(() => {
                    return memberPaymentList.value
                        .filter(m => !m.isPaid)
                        .reduce((sum, m) => sum + m.totalOwedAmount, 0);
                });

                const qrCodeUrl = computed(() => {
                    return `https://promptpay.io/${accountNumber.value}/85.png`;
                });

                // --- HISTORY LOGIC ---

                function openHistoryModal() {
                    showHistoryModal.value = true;
                }

                const recordedWeeksList = computed(() => {
                    const weeksSet = new Set();
                    weeksSet.add(currentWeekKey.value);
                    
                    Object.values(paymentRecords.value).forEach(memberRecs => {
                        Object.keys(memberRecs).forEach(wKey => weeksSet.add(wKey));
                    });

                    return Array.from(weeksSet).sort().reverse();
                });

                const fullHistoryList = computed(() => {
                    const list = [];
                    
                    Object.keys(paymentRecords.value).forEach(mId => {
                        const mObj = members.value.find(m => m.id === mId);
                        const mName = mObj ? mObj.name : `สมาชิก ID ${mId}`;
                        const memberRecs = paymentRecords.value[mId];

                        Object.keys(memberRecs).forEach(wKey => {
                            const rec = memberRecs[wKey];
                            if (rec && (rec.paid || rec.paidAt || rec.customAdjustment)) {
                                const fee = calculateWeekFee(wKey, rec.paid) + (rec.customAdjustment || 0);
                                list.push({
                                    memberId: mId,
                                    memberName: mName,
                                    weekKey: wKey,
                                    weekLabel: getWeekLabelFromKey(wKey),
                                    paid: rec.paid || false,
                                    paidAt: rec.paidAt || null,
                                    paidAtFormatted: rec.paidAt ? new Date(rec.paidAt).toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' }) : 'ไม่ระบุเวลา',
                                    slipUrl: rec.slipUrl || null,
                                    customAdjustment: rec.customAdjustment || 0,
                                    amount: fee
                                });
                            }
                        });
                    });

                    // Sort newest paid first
                    return list.sort((a, b) => {
                        if (a.paidAt && b.paidAt) return new Date(b.paidAt) - new Date(a.paidAt);
                        return b.weekKey.localeCompare(a.weekKey);
                    });
                });

                const filteredHistoryList = computed(() => {
                    return fullHistoryList.value.filter(item => {
                        const matchWeek = (historyFilterWeek.value === 'ALL') || (item.weekKey === historyFilterWeek.value);
                        const matchSearch = !historySearchQuery.value.trim() || item.memberName.toLowerCase().includes(historySearchQuery.value.toLowerCase().trim());
                        return matchWeek && matchSearch;
                    });
                });

                const historyTotalAmountCollected = computed(() => {
                    return filteredHistoryList.value
                        .filter(i => i.paid)
                        .reduce((sum, i) => sum + i.amount, 0);
                });

                function viewSlipFromHistory(item) {
                    currentViewingSlip.value = {
                        memberName: item.memberName,
                        slipUrl: item.slipUrl,
                        paidAt: item.paidAtFormatted
