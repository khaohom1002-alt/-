                        'bg-amber-50/70 border-amber-200 hover:border-amber-300',
                        'bg-rose-50/70 border-rose-200 hover:border-rose-300'
                    ];
                    return bgClasses[index % bgClasses.length];
                }

                return {
                    now,
                    currentDateFormatted,
                    selectedWeekOffset,
                    selectedWeekLabel,
                    currentStatusInfo,
                    members,
