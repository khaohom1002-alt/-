                    navigator.clipboard.writeText(text).then(() => {
                        Swal.fire({
                            title: 'คัดลอกข้อความสรุปแล้ว!',
                            text: 'นำไปวางในไลน์กลุ่มห้องได้เลย',
                            icon: 'success',
                            confirmButtonColor: '#F48FB1',
                            timer: 2000
                        });
                    });
