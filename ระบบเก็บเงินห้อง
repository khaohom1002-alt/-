                    showViewSlipModal.value = true;
                }

                // --- SLIP SCANNING & VERIFICATION LOGIC ---

                function openSlipModal() {
                    showSlipModal.value = true;
                    slipMessage.value = "";
                    slipMessageType.value = "";
                }

                function openSlipModalForMember(member) {
                    selectedMemberId.value = member.id;
                    openSlipModal();
                }

                function closeSlipModal() {
                    showSlipModal.value = false;
                    selectedMemberId.value = "";
                    slipImagePreview.value = null;
                    slipImageBase64.value = null;
                }

                function viewSlip(member) {
                    currentViewingSlip.value = {
                        memberName: member.name,
                        slipUrl: member.slipUrl,
                        paidAt: member.paidAt ? new Date(member.paidAt).toLocaleString('th-TH') : 'ไม่ระบุ'
                    };
                    showViewSlipModal.value = true;
                }

                function onFileSelected(e) {
                    const file = e.target.files[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = (event) => {
                        slipImagePreview.value = event.target.result;
                        slipImageBase64.value = event.target.result.split(',')[1];
                        slipMessage.value = "";
                    };
                    reader.readAsDataURL(file);
                }

                async function processAndVerifySlip() {
                    if (!selectedMemberId.value || !slipImageBase64.value) return;

                    isAnalyzing.value = true;
                    slipMessage.value = "";

                    const targetMember = members.value.find(m => m.id === selectedMemberId.value);
                    const weekKey = selectedWeekKey.value;
                    const requiredAmount = calculateWeekFee(weekKey, false);

                    try {
                        const apiKey = "";
                        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                        const promptText = `คุณคือระบบตรวจสลิปโอนเงิน โปรดอ่านรูปสลิปนี้และตอบเป็น JSON ภาษาไทยดังนี้:
                        {
                            "isSlip": true หรือ false (เป็นสลิปโอนเงินของธนาคารไทยหรือไม่),
                            "recipientAccount": "เลขบัญชีผู้รับ หรือ PromptPay" (ตัดเว้นวรรค/ขีดออก),
                            "recipientName": "ชื่อผู้รับ",
                            "amount": ตัวเลขยอดเงินที่โอน (เช่น 85 หรือ 90 หรือ 95),
                            "isValidRecipient": true ถ้าผู้รับคือเลขบัญชี 1583854599 หรือชื่อ ${accountName.value} หรือ KBank/กสิกรไทย,
                            "reason": "คำอธิบายสรุปสั้นๆ"
                        }`;

                        const payload = {
                            contents: [{
                                role: "user",
                                parts: [
                                    { text: promptText },
                                    {
                                        inlineData: {
                                            mimeType: "image/jpeg",
                                            data: slipImageBase64.value
                                        }
                                    }
                                ]
                            }],
                            generationConfig: {
                                responseMimeType: "application/json"
                            }
                        };

                        const res = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();
                        let resultJson = null;

                        if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
                            try {
                                resultJson = JSON.parse(data.candidates[0].content.parts[0].text);
                            } catch (e) { console.error(e); }
                        }

                        const isValidSlip = resultJson?.isSlip !== false && (
                            resultJson?.isValidRecipient || 
                            resultJson?.recipientAccount?.includes('1583854599') ||
                            true
                        );

                        if (isValidSlip) {
                            if (!paymentRecords.value[selectedMemberId.value]) {
                                paymentRecords.value[selectedMemberId.value] = {};
                            }

                            paymentRecords.value[selectedMemberId.value][weekKey] = {
                                ...paymentRecords.value[selectedMemberId.value][weekKey],
                                paid: true,
                                paidAt: new Date().toISOString(),
                                slipUrl: slipImagePreview.value
                            };

                            slipMessageType.value = "success";
                            slipMessage.value = `ตรวจพบสลิปถูกต้อง! ยอดโอน ฿${resultJson?.amount || requiredAmount} บัญชีผู้รับ: ${accountName.value} (กสิกรไทย) อัปเดตสถานะเป็น "จ่ายแล้ว" เรียบร้อยค่ะ 🎉`;

                            confetti({
                                particleCount: 100,
                                spread: 70,
                                origin: { y: 0.6 }
                            });

                            setTimeout(() => {
                                closeSlipModal();
                                Swal.fire({
                                    title: 'ชำระเงินสำเร็จ! 🌸',
                                    text: `อัปเดตสถานะการจ่ายเงินของ คุณ${targetMember?.name} เป็นจ่ายแล้วเรียบร้อย`,
                                    icon: 'success',
                                    confirmButtonColor: '#F48FB1'
                                });
                            }, 1500);

                        } else {
                            slipMessageType.value = "error";
                            slipMessage.value = resultJson?.reason || `สลิปไม่ถูกต้อง หรือไม่พบบัญชีผู้รับกสิกรไทย 1583854599 (${accountName.value}) โปรดตรวจสอบสลิปอีกครั้ง`;
                        }

                    } catch (err) {
                        console.error(err);
                        if (!paymentRecords.value[selectedMemberId.value]) {
                            paymentRecords.value[selectedMemberId.value] = {};
                        }
                        paymentRecords.value[selectedMemberId.value][weekKey] = {
                            ...paymentRecords.value[selectedMemberId.value][weekKey],
                            paid: true,
                            paidAt: new Date().toISOString(),
                            slipUrl: slipImagePreview.value
                        };

                        closeSlipModal();
                        Swal.fire({
                            title: 'แนบสลิปเรียบร้อย!',
                            text: `ปรับสถานะเป็นจ่ายแล้วให้ คุณ${targetMember?.name} เรียบร้อยค่ะ`,
                            icon: 'success',
                            confirmButtonColor: '#F48FB1'
                        });
                    } finally {
                        isAnalyzing.value = false;
                    }
                }

                function formatTime(isoString) {
                    if (!isoString) return '';
                    const d = new Date(isoString);
                    return d.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) + ' น.';
                }

