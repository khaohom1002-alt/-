                    text += `🎯 ยอดรวมประจำสัปดาห์: ฿${expectedTotalAmount.value.toLocaleString()}\n`;
                    text += `💵 เก็บได้แล้ว: ฿${totalCollectedAmount.value.toLocaleString()} (${paidCount.value}/${members.value.length} คน)\n`;
                    text += `⏳ ยังขาดอยู่: ฿${remainingAmount.value.toLocaleString()} (${unpaidCount.value} คน)\n\n`;

                    if (unpaidList.length > 0) {
                        text += `❌ **รายชื่อคนที่ยังไม่จ่าย:**\n`;
