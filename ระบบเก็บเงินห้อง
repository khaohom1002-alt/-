                    navigator.clipboard.writeText(accountNumber.value).then(() => {
                        Swal.fire({
                            title: 'คัดลอกสำเร็จ!',
                            text: `เลขบัญชี ${accountNumber.value} (${accountName.value}) ถูกคัดลอกแล้ว`,
                            icon: 'success',
                            confirmButtonColor: '#F48FB1',
                            timer: 1800
                        });
                    });
                }

                function copySummaryReport() {
