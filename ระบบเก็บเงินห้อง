<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เก็บเงินห้อง ม.4/2 🌸</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Kanit & Mitr) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Mitr:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Canvas Confetti for Celebration Effect -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- SweetAlert2 for Pretty Modals -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pastel: {
                            pink: '#FFD1DC',
                            pinkDark: '#F48FB1',
                            pinkDeep: '#EC4899',
                            purple: '#E1BEE7',
                            purpleDark: '#C084FC',
                            blue: '#B3E5FC',
                            sky: '#81D4FA',
                            yellow: '#FFF59D',
                            green: '#C8E6C9',
                            cream: '#FFF9F5'
                        }
                    },
                    fontFamily: {
                        kanit: ['Kanit', 'sans-serif'],
                        mitr: ['Mitr', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background: linear-gradient(135deg, #FFF0F5 0%, #F3E8FF 50%, #E0F2FE 100%);
            background-attachment: fixed;
            min-height: 100vh;
            color: #374151;
        }

        .header-title-gradient {
            background: linear-gradient(135deg, #EC4899 0%, #A855F7 50%, #F43F5E 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .pastel-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(251, 207, 232, 0.8);
            box-shadow: 0 10px 25px -5px rgba(244, 143, 177, 0.12), 0 8px 10px -6px rgba(244, 143, 177, 0.08);
            border-radius: 1.25rem;
        }

        /* Badge pulse & pop animations */
        .status-badge-pop {
            animation: badge-pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes badge-pop {
            0% { transform: scale(0); }
            100% { transform: scale(1); }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FFF0F5;
        }
        ::-webkit-scrollbar-thumb {
            background: #F48FB1;
            border-radius: 10px;
        }
    </style>
</head>
<body class="p-3 sm:p-6 md:p-8 relative overflow-x-hidden">

    <!-- Background Soft Color Blobs -->
    <div class="fixed top-0 left-10 w-80 h-80 bg-pink-200/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed top-1/3 right-10 w-80 h-80 bg-purple-200/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed bottom-10 left-1/4 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div id="app" class="max-w-5xl mx-auto space-y-6">

        <header class="pastel-card p-5 sm:p-8 text-center relative overflow-hidden">
            <!-- Top Line Accent -->
            <div class="absolute top-0 left-0 right-0 h-2.5 bg-gradient-to-r from-pink-400 via-purple-400 to-sky-400"></div>

            <div class="relative z-10 space-y-3">
                <div class="inline-flex items-center gap-2 bg-pink-100/80 text-pink-700 border border-pink-200 px-4 py-1.5 rounded-full text-sm font-semibold shadow-xs">
                    <i class="fa-solid fa-piggy-bank text-lg text-pink-500"></i>
                    <span>ระบบเก็บเงินห้อง ม.4/2 ✨</span>
                </div>
                <h1 class="text-3xl sm:text-5xl font-extrabold tracking-wide font-mitr header-title-gradient drop-shadow-xs">
                    เก็บเงินห้อง ม.4/2 🌸
                </h1>
                <p class="text-xs sm:text-sm text-pink-900/80 max-w-xl mx-auto bg-pink-50/80 py-1.5 px-4 rounded-full border border-pink-200 font-medium shadow-2xs">
                    💡 อัตรา 85 บาท/สัปดาห์ | จ่ายปกติ จ.-ศ. (23:59น.) | เสาร์-อาทิตย์ ปรับ +5฿/วัน!
                </p>
                
                <!-- Date & Status Banner -->
                <div class="mt-2 inline-flex flex-wrap items-center justify-center gap-3 bg-white/90 border border-pink-200 px-5 py-2.5 rounded-2xl shadow-2xs text-xs sm:text-sm">
                    <span class="text-slate-700 font-medium">
                        <i class="fa-regular fa-calendar-days text-pink-500 mr-1.5"></i> วันนี้: <b class="text-pink-900">{{ currentDateFormatted }}</b>
                    </span>
                    <span class="text-pink-200">|</span>
                    <span class="font-bold" :class="currentStatusInfo.color">
                        <i :class="currentStatusInfo.icon" class="mr-1"></i>
                        {{ currentStatusInfo.text }}
                    </span>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            
            <!-- Left Side: Bank Details & QR -->
            <div class="md:col-span-5 pastel-card p-6 flex flex-col justify-between items-center text-center space-y-4 border-l-8 border-l-pink-400">
                <div class="w-full space-y-2">
                    <span class="bg-pink-100 text-pink-800 text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider">
                        ⚡ ช่องทางชำระเงิน
                    </span>
                    <h3 class="text-xl font-extrabold text-slate-800 font-mitr">สแกน QR Code เพื่อจ่ายเงิน</h3>
                    <p class="text-xs text-pink-600 font-medium">✨ รองรับทุกธนาคาร / พร้อมเพย์ ✨</p>
                </div>

                <!-- QR Code Container -->
                <div class="relative group my-2 p-1.5 bg-pink-50 rounded-3xl border-2 border-pink-200 shadow-xs">
                    <div class="bg-white p-3 rounded-[1.3rem]">
                        <img :src="qrCodeUrl" alt="PromptPay QR Code" class="w-48 h-48 sm:w-52 sm:h-52 object-contain rounded-lg">
                    </div>
                    <div class="absolute inset-0 bg-pink-900/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-3xl flex items-center justify-center">
                        <span class="bg-pink-600 text-white text-xs px-3 py-1.5 rounded-xl font-bold shadow-md">
                            <i class="fa-solid fa-qrcode mr-1 text-pink-200"></i> พร้อมเพย์ กสิกร (฿85)
                        </span>
                    </div>
                </div>

                <!-- Account Info Box -->
                <div class="w-full bg-pink-50/60 border border-pink-200 p-4 rounded-2xl space-y-2">
                    <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
                        <span><i class="fa-solid fa-building-columns text-emerald-600 mr-1"></i> ธนาคารกสิกรไทย</span>
                        <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md text-[11px] font-bold">KBank</span>
                    </div>
                    <div class="text-xs text-left font-semibold text-slate-700 flex items-center justify-between">
                        <span><i class="fa-solid fa-user-check text-pink-600 mr-1"></i> เจ้าของบัญชี: <b class="text-slate-900 text-sm font-extrabold">{{ accountName }}</b></span>
                        <span class="bg-pink-100 text-pink-700 text-[10px] px-2 py-0.5 rounded-full font-bold">ม.4/2</span>
                    </div>
                    <div class="flex items-center justify-between bg-white p-2 rounded-xl border border-pink-200">
                        <span class="font-mono text-xl font-extrabold text-slate-800 tracking-wider">{{ accountNumber }}</span>
                        <button @click="copyAccountNumber" class="bg-pink-500 hover:bg-pink-600 active:scale-95 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all shadow-xs">
                            <i class="fa-regular fa-copy mr-1"></i> คัดลอก
                        </button>
                    </div>
                    <p class="text-[11px] text-left text-pink-600 font-medium pt-0.5">
                        📌 โปรดแนบสลิปหลังโอนเงินเพื่อให้ระบบตรวจอัตโนมัติ
                    </p>
                </div>
            </div>

            <!-- Right Side: Navigation & Summary Dashboard -->
            <div class="md:col-span-7 space-y-6 flex flex-col justify-between">
                
                <!-- Week Selector Bar -->
                <div class="pastel-card p-4 flex flex-wrap items-center justify-between gap-3 border-t-4 border-t-pink-400">
                    <div class="flex items-center gap-3">
                        <button @click="changeWeek(-1)" class="w-10 h-10 rounded-2xl bg-pink-50 hover:bg-pink-100 text-pink-700 flex items-center justify-center transition border border-pink-200 font-bold">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <div class="text-center">
                            <div class="text-[11px] text-pink-600 font-bold uppercase tracking-wider">สัปดาห์ที่เลือก</div>
                            <div class="font-bold text-slate-800 text-sm sm:text-base font-mitr">
                                {{ selectedWeekLabel }}
                            </div>
                        </div>
                        <button @click="changeWeek(1)" class="w-10 h-10 rounded-2xl bg-pink-50 hover:bg-pink-100 text-pink-700 flex items-center justify-center transition border border-pink-200 font-bold">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>

                    <button @click="resetToCurrentWeek" v-if="selectedWeekOffset !== 0" class="text-xs bg-pink-500 hover:bg-pink-600 text-white font-bold px-3.5 py-2 rounded-xl transition shadow-xs">
                        <i class="fa-solid fa-arrow-rotate-left mr-1"></i> กลับสัปดาห์ปัจจุบัน
                    </button>
                </div>

                <!-- Metrics Dashboard Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-3.5">
                    
                    <!-- 1. Expected Total Target -->
                    <div class="pastel-card p-3.5 text-center space-y-1 bg-sky-50/60 border-b-4 border-b-sky-400">
                        <div class="w-8 h-8 mx-auto bg-sky-400 text-white rounded-2xl flex items-center justify-center text-xs shadow-xs font-bold">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>
                        <div class="text-[11px] text-sky-900 font-bold">ยอดที่ต้องเก็บรวม</div>
                        <div class="text-base sm:text-lg font-extrabold text-sky-700 font-mitr">
                            ฿{{ expectedTotalAmount.toLocaleString() }}
                        </div>
                    </div>

                    <!-- 2. Total Collected -->
                    <div class="pastel-card p-3.5 text-center space-y-1 bg-emerald-50/60 border-b-4 border-b-emerald-400">
                        <div class="w-8 h-8 mx-auto bg-emerald-400 text-white rounded-2xl flex items-center justify-center text-xs shadow-xs font-bold">
                            <i class="fa-solid fa-coins"></i>
                        </div>
                        <div class="text-[11px] text-emerald-900 font-bold">เก็บได้แล้ว</div>
                        <div class="text-base sm:text-lg font-extrabold text-emerald-700 font-mitr">
                            ฿{{ totalCollectedAmount.toLocaleString() }}
                        </div>
                    </div>

                    <!-- 3. Remaining Unpaid -->
                    <div class="pastel-card p-3.5 text-center space-y-1 bg-rose-50/60 border-b-4 border-b-rose-400">
                        <div class="w-8 h-8 mx-auto bg-rose-400 text-white rounded-2xl flex items-center justify-center text-xs shadow-xs font-bold">
                            <i class="fa-solid fa-hand-holding-dollar"></i>
                        </div>
                        <div class="text-[11px] text-rose-900 font-bold">ยอดที่ยังขาดอยู่</div>
                        <div class="text-base sm:text-lg font-extrabold text-rose-600 font-mitr">
                            ฿{{ remainingAmount.toLocaleString() }}
                        </div>
                    </div>

                    <!-- 4. Paid Count -->
                    <div class="pastel-card p-3.5 text-center space-y-1 bg-purple-50/60 border-b-4 border-b-purple-400">
                        <div class="w-8 h-8 mx-auto bg-purple-400 text-white rounded-2xl flex items-center justify-center text-xs shadow-xs font-bold">
                            <i class="fa-solid fa-user-check"></i>
                        </div>
                        <div class="text-[11px] text-purple-900 font-bold">จ่ายแล้ว / สมาชิก</div>
                        <div class="text-base sm:text-lg font-extrabold text-purple-700 font-mitr">
                            {{ paidCount }}/{{ members.length }} คน
                        </div>
                    </div>

                </div>

                <!-- Rules Info Card -->
                <div class="pastel-card p-5 bg-amber-50/60 border border-amber-200/80 space-y-2">
                    <h4 class="font-extrabold text-xs text-amber-900 uppercase tracking-wider flex items-center gap-1.5 font-mitr">
                        <i class="fa-solid fa-star text-amber-500"></i> กฎการเก็บเงินและค่าปรับ
                    </h4>
                    <ul class="text-xs text-slate-700 space-y-1 pl-4 list-disc font-medium">
                        <li><span class="text-emerald-700 font-bold">จันทร์ - ศุกร์ (23:59น.):</span> ยอดปกติ <b>85 บาท</b></li>
                        <li><span class="text-amber-700 font-bold">วันเสาร์ (00:00 - 23:59น.):</span> เกินกำหนดวันแรก ปรับเพิ่ม +5 บาท (รวม <b>90 บาท</b>)</li>
                        <li><span class="text-rose-700 font-bold">วันอาทิตย์เป็นต้นไป:</span> เกินกำหนดวันที่สอง ปรับเพิ่มอีก +5 บาท (รวม <b>95 บาท</b>)</li>
                        <li><span class="text-purple-700 font-bold">สัปดาห์ใหม่:</span> ยอดคงค้างทบสะสมอัตโนมัติ</li>
                    </ul>
                </div>

            </div>
        </div>

        <main class="pastel-card p-6 space-y-6">
            
            <!-- List Header & Actions (Cleaned up for general users) -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-pink-100 pb-4">
                <div>
                    <h2 class="text-2xl font-extrabold text-slate-800 font-mitr flex items-center gap-2">
                        <span>👥 รายชื่อสมาชิกห้อง</span>
                        <span class="text-xs font-bold text-pink-700 bg-pink-100/80 border border-pink-200 px-3 py-1 rounded-full">
                            {{ members.length }} คน
                        </span>
                        <span v-if="isAdminUnlocked" class="text-xs font-extrabold bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-0.5 rounded-full flex items-center gap-1">
                            <i class="fa-solid fa-lock-open text-xs"></i> โหมดเหรัญญิกเปิดอยู่
                        </span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5 font-medium">สัญลักษณ์ติ๊กถูก (✓) หรือ กากบาท (✕) แสดงสถานะหน้าชื่อสมาชิก</p>
                </div>

                <!-- Primary Action Buttons -->
                <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                    <button @click="openSlipModal()" class="flex-1 sm:flex-none bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow-xs flex items-center justify-center gap-1.5 active:scale-95">
                        <i class="fa-solid fa-camera font-bold"></i> 📸 แจ้งโอน / แนบสลิป
                    </button>
                    <button @click="copySummaryReport" class="flex-1 sm:flex-none bg-purple-500 hover:bg-purple-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow-xs flex items-center justify-center gap-1.5 active:scale-95">
                        <i class="fa-solid fa-share-nodes"></i> สรุปส่งไลน์
                    </button>
                </div>
            </div>

            <!-- Member Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div v-for="(member, index) in memberPaymentList" :key="member.id" 
                     class="p-4 rounded-2xl border transition-all duration-200 flex items-center justify-between gap-3 relative overflow-hidden shadow-2xs"
                     :class="member.isPaid ? 'bg-emerald-50/70 border-emerald-300' : getMemberCardBg(index)">
                    
                    <!-- Left: Status Icon (Checkmark / Cross) -->
                    <div class="flex items-center gap-3.5">
                        <div class="flex-shrink-0">
                            <div v-if="member.isPaid" 
                                 class="w-11 h-11 rounded-2xl bg-emerald-500 text-white flex items-center justify-center text-lg shadow-xs border-2 border-white status-badge-pop"
                                 title="จ่ายเรียบร้อยแล้ว">
                                <i class="fa-solid fa-check font-extrabold"></i>
                            </div>
                            <div v-else 
                                 class="w-11 h-11 rounded-2xl bg-rose-400 text-white flex items-center justify-center text-lg shadow-xs border-2 border-white status-badge-pop"
                                 title="ยังไม่ได้จ่าย">
                                <i class="fa-solid fa-xmark font-extrabold"></i>
                            </div>
                        </div>

                        <div>
                            <div class="font-bold text-slate-800 flex items-center gap-2">
                                <span>{{ member.name }}</span>
                                <span v-if="member.customAdjustment !== 0" class="bg-purple-100 text-purple-700 text-[10px] font-extrabold px-2 py-0.5 rounded-full border border-purple-200">
                                    ปรับเงิน {{ member.customAdjustment > 0 ? '+' : '' }}{{ member.customAdjustment }}฿
                                </span>
                                <span v-if="member.totalUnpaidWeeks > 1 && !member.isPaid" class="bg-rose-500 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full shadow-2xs">
                                    ค้าง {{ member.totalUnpaidWeeks }} สัปดาห์
                                </span>
                            </div>
                            <div class="text-xs mt-0.5">
                                <span v-if="member.isPaid" class="text-emerald-700 font-bold flex items-center gap-1">
                                    <i class="fa-solid fa-circle-check text-emerald-500"></i> ชำระเรียบร้อย (฿{{ member.currentWeekFee }})
                                    <span v-if="member.paidAt" class="text-[10px] text-slate-400 font-normal">({{ formatTime(member.paidAt) }})</span>
                                </span>
                                <span v-else class="text-rose-600 font-medium flex flex-col sm:flex-row sm:items-center gap-1">
                                    <span>ต้องชำระ: <b class="text-sm font-extrabold text-rose-600">฿{{ member.totalOwedAmount }}</b></span>
                                    <span class="text-[11px] text-slate-600 bg-white/80 border border-pink-200 px-2 py-0.5 rounded-md font-semibold">
                                        (ค่าห้อง ฿85 <template v-if="member.penaltyFee > 0">+ ปรับเลท ฿{{ member.penaltyFee }}</template><template v-if="member.customAdjustment !== 0"> {{ member.customAdjustment > 0 ? '+' : '' }}ปรับเปลี่ยน ฿{{ member.customAdjustment }}</template>)
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Actions / Admin Controls -->
                    <div class="flex flex-col sm:flex-row items-end sm:items-center gap-2">
                        <div v-if="isAdminUnlocked" class="flex items-center gap-1 bg-amber-50 p-1 rounded-xl border border-amber-200">
                            <button @click="toggleMemberPaymentStatus(member)" 
                                    class="px-2 py-1 rounded-lg text-[11px] font-extrabold transition shadow-2xs"
                                    :class="member.isPaid ? 'bg-rose-500 text-white hover:bg-rose-600' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
                                    :title="member.isPaid ? 'เปลี่ยนเป็นยังไม่ได้จ่าย' : 'ทำรายการว่าจ่ายแล้วทันที'">
                                <i :class="member.isPaid ? 'fa-solid fa-rotate-left' : 'fa-solid fa-check'"></i>
                                {{ member.isPaid ? 'ยกเลิกจ่าย' : 'ปรับจ่ายแล้ว' }}
                            </button>
                            <button @click="openCustomAmountModal(member)" 
                                    class="px-2 py-1 bg-purple-500 hover:bg-purple-600 text-white rounded-lg text-[11px] font-extrabold transition shadow-2xs"
                                    title="แก้ปรับเพิ่ม/ลดเงินคนนี้">
                                <i class="fa-solid fa-pen-to-square"></i> แก้เงิน
                            </button>
                        </div>

                        <template v-if="member.isPaid && !isAdminUnlocked">
                            <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center gap-1 shadow-2xs">
                                <i class="fa-solid fa-circle-check text-emerald-600"></i> จ่ายแล้ว
                            </span>
                            <button v-if="member.slipUrl" @click="viewSlip(member)" class="bg-pink-500 hover:bg-pink-600 text-white px-2.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1 shadow-2xs" title="ดูสลิปหลักฐาน">
                                <i class="fa-solid fa-receipt"></i> ดูสลิป
                            </button>
                        </template>

                        <template v-if="!member.isPaid && !isAdminUnlocked">
                            <button @click="openSlipModalForMember(member)" class="bg-pink-500 hover:bg-pink-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-2xs active:scale-95">
                                <i class="fa-solid fa-qrcode"></i> จ่าย ฿{{ member.totalOwedAmount }}
                            </button>
                        </template>
                    </div>

                </div>
            </div>

            <!-- Empty State if No Members -->
            <div v-if="members.length === 0" class="text-center py-12 text-pink-300 space-y-3">
                <i class="fa-solid fa-users-slash text-4xl text-pink-300"></i>
                <p class="text-sm font-medium">ไม่พบสมาชิกในระบบ</p>
            </div>

        </main>

        <!-- 🛠️ DEDICATED SECONDARY BLOCK: เครื่องมือเพิ่มเติม & จัดการระบบ (ประวัติการโอน & โหมดเหรัญญิก) -->
        <section class="pastel-card p-5 bg-slate-50/70 border border-slate-200 space-y-4">
